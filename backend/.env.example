# ─── API security ────────────────────────────────────────────────────────────
# Set a long, random secret. Enter the SAME value in the app (API key field).
API_KEY=replace-this-with-a-long-random-local-key

# ─── Check mode ──────────────────────────────────────────────────────────────
# demo         → safe UI/test mode; sends NO real stock requests (default)
# http_json    → forwards checks to your own authorised connector (CHECK_API_URL)
# zepto_direct → laptop hits Zepto's API directly with Akamai-aware backoff
CHECK_MODE=zepto_direct

# ─── http_json connector (only needed when CHECK_MODE=http_json) ─────────────
CHECK_API_URL=
CHECK_API_BEARER_TOKEN=

# ─── Concurrency & timing ────────────────────────────────────────────────────
# Max parallel requests sent at once. Keep ≤ 8 to respect rate limits.
MAX_CONCURRENCY=6
# Seconds between full location scans. Minimum 60.
SCAN_INTERVAL_SECONDS=180
# Per-request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=15
# How long to pause after a 403/429 block (seconds). Minimum 60.
BLOCK_COOLDOWN_SECONDS=900
